# Copy to .env and adjust. Never commit the real .env file.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave unset to use SQLite locally; set for PostgreSQL:
# DATABASE_URL=postgres://autism:autism@localhost:5432/autism

ALLOW_DOCTOR_SELF_REGISTRATION=1
LOG_LEVEL=INFO
